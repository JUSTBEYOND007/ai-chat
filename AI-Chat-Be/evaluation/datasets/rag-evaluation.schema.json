{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-chat.local/schemas/rag-evaluation-v1.json",
  "title": "Flow-Chat RAG Evaluation Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "description", "defaultTopK", "cases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "defaultTopK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluationCase"
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerable"],
      "properties": {
        "answerable": {
          "type": "boolean"
        },
        "documentFileNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "documentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredKeywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "question", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "answerable",
            "unanswerable",
            "exact_term",
            "multi_document",
            "contextual_followup"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
